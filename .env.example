# 环境变量配置
# 复制此文件为 .env 并填写实际值；生产环境在 Deno Deploy 控制台或 CI Secret 中配置

# 访问密码（设置后所有代理路径需要鉴权：Basic proxy:密码，或 x-proxy-key: 密码）
# PROXY_PASSWORD=your-secret-password

# Docker Hub 账号或 Access Token（换取拉取 token，缓解匿名限速）
# DOCKER_HUB_USERNAME=your-username
# DOCKER_HUB_PASSWORD=your-password-or-token

# GitHub API token（只给 api.github.com 的 /repos/* 与 /rate_limit 只读请求补身份，绕开共享出口 IP 的匿名 60 次/时）
# 账号端点不注入；请用未勾选任何 scope 的 token 或专用只读账号，带 repo scope 会暴露私有仓库
# GITHUB_TOKEN=

# 仓库名单（JSON 数组，支持通配符）
# WHITE_LIST=["hotier/*","octocat/Hello-World"]
# BLACK_LIST=["spam/*"]

# 超过该大小（GB）的 Release 直接 302 回源
# SIZE_LIMIT=1

# 小体积 raw/blob 文件改走 jsDelivr
# USE_JSDELIVR=true

# 每 IP 每分钟代理请求上限，0 表示不限制
# RATE_LIMIT=120

# 关闭 Release 强缓存头（默认开启）
# CACHE_RELEASE=false

# 统计与按天存档
# STATS_RETENTION_DAYS=180        # 日桶保留天数，超期自动清理（累计桶不受影响）
# STATS_FLUSH_REQUESTS=200        # 缓冲多少条请求后落库
# STATS_FLUSH_INTERVAL_MS=120000  # 低流量时的兜底落库间隔
# STATS_SHARDS=1                  # 计数器键分片数，写竞争激烈时调大

# Deno Deploy Analytics API Token（供 /api/deno-analytics 使用）
# DENO_API_TOKEN=

# Deno Deploy 部署 Token（供 npm run deploy / CI 使用）
# DENO_DEPLOY_TOKEN=
