# 环境变量配置
# 复制此文件为 .env 并填写实际值

# 访问密码（可选，设置后需要 Basic Auth）
# PROXY_PASSWORD=your-secret-password

# 本地开发端口（默认 8000）
# PORT=8000

# Docker Hub 账号（可选，提升限速）
# DOCKER_HUB_USERNAME=your-username
# DOCKER_HUB_PASSWORD=your-password-or-token

# Deno Deploy Token（用于 CLI 部署）
# DENO_DEPLOY_TOKEN=ddp_xxxxxxxxxxxxxxxxxxxx
