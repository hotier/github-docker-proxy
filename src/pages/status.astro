---
// 状态和配置页面
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import DockerIcon from '../components/icons/DockerIcon.astro';
---

<Layout title="服务状态" activeNav="/status">
  <!-- 页面标题 -->
  <div class="mb-6">
    <h1 class="text-3xl font-medium text-on-surface mb-2">服务状态</h1>
    <p class="text-on-surface-variant">实时监控各节点状态和请求配额使用情况</p>
  </div>

  <!-- 节点状态卡片 -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6" id="status-cards">
    <!-- GitHub 加速状态 -->
    <div class="bg-surface-container-highest rounded-3xl p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <GitHubIcon size={32} class="text-on-surface" />
          <div>
            <h3 class="font-medium text-on-surface">GitHub 加速</h3>
            <p class="text-xs text-on-surface-variant">github.com 资源代理</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="github-status-dot" class="w-3 h-3 rounded-full bg-gray-400 animate-pulse"></span>
          <span id="github-status-text" class="text-sm text-on-surface-variant">检测中...</span>
        </div>
      </div>
      
      <!-- 响应时间 -->
      <div class="mb-3">
        <div class="flex justify-between text-sm mb-1">
          <span class="text-on-surface-variant">响应时间</span>
          <span id="github-response-time" class="text-on-surface font-mono">-</span>
        </div>
        <div class="w-full bg-surface-container rounded-full h-2">
          <div id="github-response-bar" class="bg-primary h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
      </div>

      <!-- 今日请求数 -->
      <div class="flex items-center justify-between text-sm">
        <span class="text-on-surface-variant">今日请求</span>
        <span id="github-today-requests" class="text-on-surface font-mono">-</span>
      </div>
    </div>

    <!-- Docker 加速状态 -->
    <div class="bg-surface-container-highest rounded-3xl p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <DockerIcon size={32} class="text-on-surface" />
          <div>
            <h3 class="font-medium text-on-surface">Docker 加速</h3>
            <p class="text-xs text-on-surface-variant">容器镜像仓库代理</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="docker-status-dot" class="w-3 h-3 rounded-full bg-gray-400 animate-pulse"></span>
          <span id="docker-status-text" class="text-sm text-on-surface-variant">检测中...</span>
        </div>
      </div>
      
      <!-- 响应时间 -->
      <div class="mb-3">
        <div class="flex justify-between text-sm mb-1">
          <span class="text-on-surface-variant">响应时间</span>
          <span id="docker-response-time" class="text-on-surface font-mono">-</span>
        </div>
        <div class="w-full bg-surface-container rounded-full h-2">
          <div id="docker-response-bar" class="bg-primary h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
      </div>

      <!-- 今日请求数 -->
      <div class="flex items-center justify-between text-sm">
        <span class="text-on-surface-variant">今日请求</span>
        <span id="docker-today-requests" class="text-on-surface font-mono">-</span>
      </div>
    </div>
  </div>

  <!-- 访问统计 -->
  <div class="bg-surface-container-highest rounded-3xl p-6 mb-6">
    <h2 class="text-xl font-medium text-on-surface mb-4 flex items-center gap-3">
      <span class="material-symbols-outlined text-primary">analytics</span>
      访问统计
    </h2>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-surface rounded-2xl p-4">
        <div class="text-sm text-on-surface-variant mb-1">今日访问</div>
        <div class="text-2xl font-medium text-on-surface" id="total-today-requests">-</div>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <div class="text-sm text-on-surface-variant mb-1">今日流量</div>
        <div class="text-2xl font-medium text-primary" id="total-today-bytes">-</div>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <div class="text-sm text-on-surface-variant mb-1">累计访问</div>
        <div class="text-2xl font-medium text-on-surface" id="total-requests">-</div>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <div class="text-sm text-on-surface-variant mb-1">累计流量</div>
        <div class="text-2xl font-medium text-primary" id="total-bytes">-</div>
      </div>
    </div>
  </div>

  <!-- 请求配额使用率 -->
  <div class="bg-surface-container-highest rounded-3xl p-6 mb-6">
    <h2 class="text-xl font-medium text-on-surface mb-4 flex items-center gap-3">
      <span class="material-symbols-outlined text-primary">speed</span>
      今日配额使用
    </h2>
    
    <div class="space-y-4">
      <!-- 请求数配额 -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <span class="text-sm text-on-surface-variant">请求次数</span>
          <span class="text-sm font-mono text-on-surface">
            <span id="quota-used">0</span> / <span id="quota-total">1,000,000</span>
          </span>
        </div>
        <div class="w-full bg-surface-container rounded-full h-3 overflow-hidden">
          <div id="quota-bar" class="bg-primary h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
        <div class="flex justify-between mt-1 text-xs text-on-surface-variant">
          <span id="quota-percentage">0%</span>
          <span id="quota-remaining">剩余 1,000,000</span>
        </div>
      </div>

      <!-- 流量配额 -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <span class="text-sm text-on-surface-variant">流量使用</span>
          <span class="text-sm font-mono text-on-surface">
            <span id="bytes-used">0 B</span> / <span id="bytes-total">100 GB</span>
          </span>
        </div>
        <div class="w-full bg-surface-container rounded-full h-3 overflow-hidden">
          <div id="bytes-bar" class="bg-secondary h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
        <div class="flex justify-between mt-1 text-xs text-on-surface-variant">
          <span id="bytes-percentage">0%</span>
          <span id="bytes-remaining">剩余 100 GB</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 实时监控 -->
  <div class="bg-surface-container-highest rounded-3xl p-6 mb-6">
    <h2 class="text-xl font-medium text-on-surface mb-4 flex items-center gap-3">
      <span class="material-symbols-outlined text-primary">monitoring</span>
      实时监控
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-surface rounded-2xl p-4">
        <div class="text-sm text-on-surface-variant mb-1">内存中请求数</div>
        <div class="text-2xl font-medium text-on-surface" id="memory-requests">-</div>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <div class="text-sm text-on-surface-variant mb-1">内存中错误数</div>
        <div class="text-2xl font-medium text-on-surface" id="memory-errors">-</div>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <div class="text-sm text-on-surface-variant mb-1">平均延迟</div>
        <div class="text-2xl font-medium text-on-surface" id="avg-duration">-</div>
      </div>
    </div>

    <button id="refresh-metrics" class="mt-4 px-4 py-2 bg-primary text-on-primary rounded-full text-sm font-medium hover:opacity-90 transition-opacity flex items-center gap-2">
      <span class="material-symbols-outlined text-sm">refresh</span>
      刷新数据
    </button>
  </div>

  <!-- 高级配置 -->
  <div class="bg-surface-container-highest rounded-3xl p-6">
    <h2 class="text-xl font-medium text-on-surface mb-4 flex items-center gap-3">
      <span class="material-symbols-outlined text-primary">settings</span>
      高级配置
    </h2>

    <div class="bg-error-container text-on-error-container rounded-2xl px-5 py-4 mb-5 flex gap-3 text-sm">
      <span class="material-symbols-outlined text-xl shrink-0">warning</span>
      <span>
        <strong>鉴权保护</strong>：如需防止滥用，可在 Deno Deploy Dashboard 中设置 
        <code class="font-mono bg-black/10 px-2 py-0.5 rounded">PROXY_PASSWORD</code> 
        环境变量启用 Basic Auth。
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-surface rounded-2xl p-4">
        <h3 class="font-medium text-on-surface mb-2 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-lg">key</span>
          访问密码
        </h3>
        <code class="text-sm text-on-surface-variant font-mono">PROXY_PASSWORD</code>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <h3 class="font-medium text-on-surface mb-2 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-lg">list</span>
          白名单
        </h3>
        <code class="text-sm text-on-surface-variant font-mono">WHITE_LIST=["owner/*"]</code>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <h3 class="font-medium text-on-surface mb-2 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-lg">block</span>
          黑名单
        </h3>
        <code class="text-sm text-on-surface-variant font-mono">BLACK_LIST=["spam/repo"]</code>
      </div>
      <div class="bg-surface rounded-2xl p-4">
        <h3 class="font-medium text-on-surface mb-2 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-lg">speed</span>
          速率限制
        </h3>
        <code class="text-sm text-on-surface-variant font-mono">RATE_LIMIT=100</code>
      </div>
    </div>
  </div>
</Layout>

<script>
  // 检查 GitHub 节点状态
  async function checkGitHubStatus() {
    try {
      const response = await fetch('/api/status/github');
      const data = await response.json();
      updateStatusUI('github', data.status === 'ok', data.responseTime || 0);
    } catch (error) {
      updateStatusUI('github', false, 0);
    }
  }

  // 检查 Docker 节点状态
  async function checkDockerStatus() {
    try {
      const response = await fetch('/api/status/docker');
      const data = await response.json();
      updateStatusUI('docker', data.status === 'ok', data.responseTime || 0);
    } catch (error) {
      updateStatusUI('docker', false, 0);
    }
  }

  // 更新状态 UI
  function updateStatusUI(type, isOk, duration) {
    const dot = document.getElementById(type + '-status-dot');
    const text = document.getElementById(type + '-status-text');
    const timeEl = document.getElementById(type + '-response-time');
    const bar = document.getElementById(type + '-response-bar');
    
    if (dot) {
      dot.className = 'w-3 h-3 rounded-full ' + (isOk ? 'bg-green-500' : 'bg-red-500');
    }
    
    if (text) {
      text.textContent = isOk ? '正常' : '异常';
      text.className = 'text-sm ' + (isOk ? 'text-green-600' : 'text-red-600');
    }
    
    if (timeEl && isOk) {
      timeEl.textContent = duration + 'ms';
    }
    
    if (bar && isOk) {
      const percent = Math.min((duration / 1000) * 100, 100);
      bar.style.width = percent + '%';
      
      if (duration < 200) {
        bar.className = 'bg-green-500 h-2 rounded-full transition-all duration-500';
      } else if (duration < 500) {
        bar.className = 'bg-yellow-500 h-2 rounded-full transition-all duration-500';
      } else {
        bar.className = 'bg-red-500 h-2 rounded-full transition-all duration-500';
      }
    }
  }

  // 获取访问统计
  async function fetchStats() {
    try {
      const response = await fetch('/api/stats');
      const data = await response.json();
      
      // GitHub 统计
      const githubTodayReq = data.today?.github?.requests || 0;
      const githubTodayByt = data.today?.github?.bytes || 0;
      const githubTotalReq = data.total?.github?.requests || 0;
      const githubTotalByt = data.total?.github?.bytes || 0;
      
      updateElement('github-today-requests', githubTodayReq.toLocaleString());
      updateElement('github-today-bytes', formatBytes(githubTodayByt));
      updateElement('github-total-requests', githubTotalReq.toLocaleString());
      updateElement('github-total-bytes', formatBytes(githubTotalByt));
      
      // Docker 统计
      const dockerTodayReq = data.today?.docker?.requests || 0;
      const dockerTodayByt = data.today?.docker?.bytes || 0;
      const dockerTotalReq = data.total?.docker?.requests || 0;
      const dockerTotalByt = data.total?.docker?.bytes || 0;
      
      updateElement('docker-today-requests', dockerTodayReq.toLocaleString());
      updateElement('docker-today-bytes', formatBytes(dockerTodayByt));
      updateElement('docker-total-requests', dockerTotalReq.toLocaleString());
      updateElement('docker-total-bytes', formatBytes(dockerTotalByt));
      
      // 总计统计
      const totalTodayReq = githubTodayReq + dockerTodayReq;
      const totalTodayByt = githubTodayByt + dockerTodayByt;
      const totalReq = githubTotalReq + dockerTotalReq;
      const totalByt = githubTotalByt + dockerTotalByt;
      
      updateElement('total-today-requests', totalTodayReq.toLocaleString());
      updateElement('total-today-bytes', formatBytes(totalTodayByt));
      updateElement('total-requests', totalReq.toLocaleString());
      updateElement('total-bytes', formatBytes(totalByt));
      
      // 更新节点卡片中的今日请求
      updateElement('github-today-requests-card', githubTodayReq.toLocaleString());
      updateElement('docker-today-requests-card', dockerTodayReq.toLocaleString());
      
      // 更新配额使用率
      updateQuotaUsage(totalTodayReq, totalTodayByt);
      
      // 渲染周统计图表
      if (data.weekly && data.weekly.length > 0) {
        renderWeeklyChart(data.weekly);
      }
    } catch (error) {
      console.error('Failed to fetch stats:', error);
    }
  }

  // 辅助函数：更新元素文本
  function updateElement(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  // 更新配额使用率
  function updateQuotaUsage(requests, bytes) {
    const QUOTA_REQUESTS = 1000000;
    const QUOTA_BYTES = 100 * 1024 * 1024 * 1024;
    
    const reqPercent = (requests / QUOTA_REQUESTS) * 100;
    const reqRemaining = QUOTA_REQUESTS - requests;
    
    const quotaBar = document.getElementById('quota-bar');
    const quotaPercent = document.getElementById('quota-percentage');
    const quotaUsed = document.getElementById('quota-used');
    const quotaRemaining = document.getElementById('quota-remaining');
    
    if (quotaBar) quotaBar.style.width = Math.min(reqPercent, 100) + '%';
    if (quotaPercent) quotaPercent.textContent = reqPercent.toFixed(2) + '%';
    if (quotaUsed) quotaUsed.textContent = requests.toLocaleString();
    if (quotaRemaining) quotaRemaining.textContent = '剩余 ' + reqRemaining.toLocaleString();
    
    const bytesPercent = (bytes / QUOTA_BYTES) * 100;
    const bytesRemaining = QUOTA_BYTES - bytes;
    
    const bytesBar = document.getElementById('bytes-bar');
    const bytesPercentEl = document.getElementById('bytes-percentage');
    const bytesUsed = document.getElementById('bytes-used');
    const bytesRemainingEl = document.getElementById('bytes-remaining');
    
    if (bytesBar) bytesBar.style.width = Math.min(bytesPercent, 100) + '%';
    if (bytesPercentEl) bytesPercentEl.textContent = bytesPercent.toFixed(4) + '%';
    if (bytesUsed) bytesUsed.textContent = formatBytes(bytes);
    if (bytesRemainingEl) bytesRemainingEl.textContent = '剩余 ' + formatBytes(bytesRemaining);
  }

  // 格式化字节数
  function formatBytes(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  // 渲染周统计图表
  function renderWeeklyChart(weeklyData) {
    const chartContainer = document.getElementById('weekly-chart');
    const labelsContainer = document.getElementById('weekly-labels');
    const weeklySection = document.getElementById('weekly-stats');
    
    if (!chartContainer || !labelsContainer) return;
    if (weeklySection) weeklySection.classList.remove('hidden');
    
    const maxRequests = Math.max(...weeklyData.map(d => d.requests), 1);
    
    chartContainer.innerHTML = weeklyData.map(day => {
      const height = (day.requests / maxRequests) * 100;
      return '<div class="flex flex-col items-center flex-1 group relative">' +
        '<div class="w-full bg-primary-container rounded-t-lg transition-all hover:bg-primary" ' +
        'style="height: ' + Math.max(height, 2) + '%" ' +
        'title="' + day.requests + ' 请求"></div></div>';
    }).join('');
    
    labelsContainer.innerHTML = weeklyData.map(day => {
      const date = new Date(day.date);
      const dayLabel = (date.getMonth() + 1) + '/' + date.getDate();
      return '<span class="flex-1 text-center">' + dayLabel + '</span>';
    }).join('');
  }

  // 获取内存监控指标
  async function fetchMetrics() {
    try {
      const response = await fetch('/api/metrics');
      const data = await response.json();
      
      const memoryRequests = document.getElementById('memory-requests');
      const memoryErrors = document.getElementById('memory-errors');
      const avgDuration = document.getElementById('avg-duration');
      
      if (memoryRequests) memoryRequests.textContent = data.totalRequests || 0;
      if (memoryErrors) memoryErrors.textContent = data.totalErrors || 0;
      if (avgDuration) avgDuration.textContent = (data.averageDuration || 0).toFixed(2) + 'ms';
    } catch (error) {
      console.error('Failed to fetch metrics:', error);
    }
  }

  // 刷新所有数据
  function refreshAll() {
    checkGitHubStatus();
    checkDockerStatus();
    fetchStats();
    fetchMetrics();
  }

  // 刷新按钮
  document.getElementById('refresh-metrics')?.addEventListener('click', refreshAll);

  // 初始加载
  refreshAll();
  
  // 每 30 秒自动刷新
  setInterval(refreshAll, 30000);
</script>
