---
// 首页 - URL 转换器
import Layout from '../layouts/Layout.astro';
import UrlConverter from '../components/UrlConverter.astro';
---

<Layout title="URL 转换器" activeNav="/">
  <!-- 页面标题 -->
  <div class="mb-6">
    <h1 class="text-3xl font-medium text-on-surface mb-2">URL 转换器</h1>
    <p class="text-on-surface-variant">粘贴 GitHub 链接或 Docker 镜像名，自动生成加速链接</p>
  </div>

  <!-- URL 转换器 -->
  <div class="bg-surface-container-highest rounded-3xl p-6 mb-6">
    <UrlConverter />
  </div>

  <!-- 使用说明 -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-surface-container rounded-2xl p-5">
      <div class="flex items-center gap-3 mb-3">
        <span class="material-symbols-outlined text-primary">download</span>
        <h3 class="font-medium text-on-surface">GitHub 加速</h3>
      </div>
      <p class="text-sm text-on-surface-variant mb-3">
        支持 Release 文件、Git 仓库、Raw 文件、源码归档的加速下载。
      </p>
      <a href="/github" class="text-primary text-sm hover:underline inline-flex items-center gap-1">
        查看详情
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>

    <div class="bg-surface-container rounded-2xl p-5">
      <div class="flex items-center gap-3 mb-3">
        <span class="material-symbols-outlined text-primary">layers</span>
        <h3 class="font-medium text-on-surface">Docker 加速</h3>
      </div>
      <p class="text-sm text-on-surface-variant mb-3">
        支持 Docker Hub、GHCR、GCR、Quay 等镜像仓库的加速拉取。
      </p>
      <a href="/docker" class="text-primary text-sm hover:underline inline-flex items-center gap-1">
        查看详情
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>
</Layout>
