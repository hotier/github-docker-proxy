{
  "name": "github-docker-proxy",
  "version": "0.1.0",
  "description": "Reverse proxy for GitHub and Docker registry on Deno Deploy",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read main.ts",
    "dev:watch": "deno run --allow-net --allow-env --allow-read --watch main.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt main.ts",
    "lint": "deno lint main.ts",
    "test": "deno test --allow-net --allow-env",
    "deploy": "deployctl deploy --project=github-docker-proxy main.ts",
    "deploy:prod": "deployctl deploy --project=github-docker-proxy --token=$DENO_DEPLOY_TOKEN main.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true
  }
}
